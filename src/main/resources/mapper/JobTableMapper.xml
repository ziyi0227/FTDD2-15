<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ftdd2.mapper.JobTableMapper">

    <select id="getHotCompany" resultType="java.util.Map">
        SELECT
            company,
            COUNT(*) AS count
        FROM
            job_table
        GROUP BY
            company
        ORDER BY
            count DESC
        LIMIT 4
    </select>
</mapper>
