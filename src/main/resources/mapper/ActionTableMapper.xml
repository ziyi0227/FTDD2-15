<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ftdd2.mapper.ActionTableMapper">

    <select id="getDeliverList" resultType="java.lang.Integer">
        SELECT job_id FROM action_table WHERE delivered = 1 AND user_id = #{id}
    </select>
</mapper>
