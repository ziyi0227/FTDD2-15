<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ftdd2.sys.mapper.JobCategoryMapper">

    <update id="update" parameterType="com.ftdd2.sys.entity.JobCategory">

    update ft_demo.job_category
    <set>
        <if test="title != null">
            title = #{title},
        </if>
    </set>
        where Tid=#{Tid}
    </update>

</mapper>
